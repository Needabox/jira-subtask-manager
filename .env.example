# Required in production (Vercel Environment Variables) for encrypting HttpOnly session cookies.
# Generate a 64-char hex secret with: openssl rand -hex 32
SESSION_SECRET=

# Required if using Atlassian OAuth 2.0 (3LO) login on Vercel.
# Configure Callback URL in Atlassian Developer Console to: https://<your-domain>/settings
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
